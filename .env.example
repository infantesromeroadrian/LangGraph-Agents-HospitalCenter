# ============================================================================
# LangGraph Medical Center - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# --- OpenAI Configuration ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60
MAX_IMAGE_ATTACHMENTS=3
MAX_IMAGE_SIZE_MB=5

# Example for Groq using the OpenAI-compatible API:
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://replace_user:replace_password@localhost:5432/medical_db

# --- Application (FastAPI) ---
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=False
APP_SECRET_KEY=change-this-to-a-random-secret-with-at-least-32-characters
JWT_SECRET_KEY=
ADMIN_API_KEY=change-this-admin-key-with-at-least-16-characters
PATIENT_TOKEN_TTL_HOURS=12
SESSION_TOKEN_TTL_HOURS=4
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax

# --- LangGraph ---
RECURSION_LIMIT=50

# --- Logging ---
LOG_LEVEL=INFO

# --- Security ---
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATE_LIMIT=120/minute
WRITE_RATE_LIMIT=30/minute
WEBSOCKET_RATE_LIMIT=90/minute

# --- LangSmith (optional, for observability) ---
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=langgraph-medical-center
